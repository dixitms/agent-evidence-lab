  "payload_exclusivity_matrix": {
    "description": "Generated at runtime by validate_fixtures.py, not stored as files. For every event_type that owns a typed payload, the runner builds one instance per FOREIGN payload and asserts the schema rejects it; it also asserts each no-payload event type rejects every payload. Derived from the schema's own event_type enum and payload list, so a 7th payload type is covered automatically the day it is added. This exists because hand-maintained exclusivity lists drifted twice during development (assistant_message could carry tool_call; tool_call/tool_result could carry compaction). Run against EVERY live agent_event version, so a new version cannot silently ship with a weaker exclusivity guarantee than the one before it.",
    "payload_event_types": [
      "tool_call",
      "tool_result",
      "thinking",
      "compaction",
      "assistant_message",
      "user_message"
    ],
    "no_payload_event_types": [
      "session_start",
      "session_end"
    ],
    "applies_to_schemas": [
      "agent_event",
      "agent_event_v02"
    ]
  }
}
