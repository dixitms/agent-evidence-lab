{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-policy-lab.local/schema/ledger/v1/run_ledger.schema.json",
  "title": "Agent Policy Lab run ledger \u2014 v1",
  "description": "Attempt and replacement history for one preregistered study. Deliberately a SEPARATE contract from experiment_run: that schema is frozen with additionalProperties:false, and reopening a frozen data contract to record workflow history would be the wrong trade. Versioned independently because one ledger may describe runs emitted under different event-schema versions.",
  "type": "object",
  "required": [
    "ledger_version",
    "preregistration_sha256",
    "runs",
    "replacements"
  ],
  "additionalProperties": false,
  "properties": {
    "ledger_version": {
      "const": "1.0.0"
    },
    "preregistration_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Hash of the study's frozen preregistration document as it stood when the study ran. Binds the ledger to a specific frozen protocol: a ledger cannot be carried across a preregistration change without that change being visible."
    },
    "runs": {
      "type": "array",
      "description": "Every attempted run, including discarded ones. Nothing is deleted.",
      "items": {
        "type": "object",
        "required": [
          "run_id",
          "pair_id",
          "task_id",
          "condition",
          "disposition"
        ],
        "additionalProperties": false,
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid"
          },
          "pair_id": {
            "type": "string",
            "minLength": 1,
            "description": "Identifies the baseline/intervention pair this run belongs to."
          },
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "condition": {
            "type": "string",
            "enum": [
              "baseline",
              "intervention"
            ]
          },
          "disposition": {
            "type": "string",
            "enum": [
              "completed_analyzable",
              "completed_not_activated",
              "discarded",
              "excluded",
              "scope_confounded"
            ]
          },
          "disposition_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "replacements": {
      "type": "array",
      "description": "Authorised replacements only. D4 permits these solely for non-substantive execution failures; a completed_analyzable or completed_not_activated run is never replaced.",
      "items": {
        "type": "object",
        "required": [
          "pair_id",
          "original_run_id",
          "replacement_run_id",
          "condition",
          "reason",
          "original_disposition",
          "authorised_at",
          "authorised_by"
        ],
        "additionalProperties": false,
        "properties": {
          "pair_id": {
            "type": "string",
            "minLength": 1
          },
          "original_run_id": {
            "type": "string",
            "format": "uuid"
          },
          "replacement_run_id": {
            "type": "string",
            "format": "uuid"
          },
          "condition": {
            "type": "string",
            "enum": [
              "baseline",
              "intervention"
            ]
          },
          "reason": {
            "type": "string",
            "enum": [
              "failed_attestation",
              "transcript_capture_failure",
              "ingestion_failure",
              "reconciliation_failure",
              "wrong_commit",
              "wrong_model",
              "wrong_policy",
              "oracle_environment_failure",
              "wrong_prompt_delivered"
            ],
            "description": "Closed list from D4. Widening it is a further dated deviation, not a run-time judgement."
          },
          "original_disposition": {
            "type": "string",
            "enum": [
              "discarded",
              "excluded",
              "scope_confounded"
            ],
            "description": "Only these may be replaced. completed_analyzable and completed_not_activated are deliberately absent from this enum, so the schema itself refuses to record a replacement the protocol forbids."
          },
          "authorised_at": {
            "type": "string",
            "format": "date-time"
          },
          "authorised_by": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
